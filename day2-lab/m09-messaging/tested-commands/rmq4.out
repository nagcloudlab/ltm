$ rabbitmqadmin publish exchange=payments routing_key=payment.completed payload='{"event":"PaymentCompleted","paymentId":"PAY-3003"}' properties='{"expiration":"5000"}'
Message published

$ curl -s -u guest:guest -X POST http://localhost:15672/api/queues/%2F/sms.dlq/get -H 'content-type: application/json' -d '{"count":2,"ackmode":"ack_requeue_true","encoding":"auto"}' | jq -c '.[] | [.payload, .properties.headers["x-death"][0].reason]'
