$ curl -s -u guest:guest -X POST http://localhost:15672/api/queues/%2F/sms.dlq/get -H 'content-type: application/json' -d '{"count":1,"ackmode":"ack_requeue_true","encoding":"auto"}' | jq '.[0].properties.headers'
{
  "x-death": [
    {
      "count": 1,
      "exchange": "payments",
      "queue": "sms",
      "reason": "rejected",
