
$ timeout 30 /opt/kafka/bin/kafka-topics.sh --bootstrap-server localhost:9093 --list

$ timeout 30 /opt/kafka/bin/kafka-topics.sh --bootstrap-server localhost:9999 --list

$ sudo systemctl stop kafka

$ timeout 30 /opt/kafka/bin/kafka-topics.sh --bootstrap-server localhost:9092 --list

$ sudo systemctl start kafka
